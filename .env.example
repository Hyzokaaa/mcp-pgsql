# Target Database Configuration (database to be analyzed by the agent)
TARGET_DATABASE_URL=postgresql://user:password@localhost:5432/company_data
# Para Oracle: TARGET_DATABASE_URL=oracle+oracledb://user:password@localhost:1521/service_name
TARGET_DB_BACKEND=postgres

# LLM Configuration
LLM_MODEL_NAME=qwen3:0.6b
LLM_TEMPERATURE=0.0
OLLAMA_CONTEXT_WINDOW=4096
AGENT_MAX_ITERATIONS=5

# API Configuration
API_TITLE=SQL Agent API
API_VERSION=0.1.0
API_PREFIX=/api/v1

# CORS Configuration (para desarrollo con React)
# Agregar las URLs de tu frontend separadas por comas
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://miapp.com"]

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
