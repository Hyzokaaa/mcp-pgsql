# System Database Configuration (for sessions, users, logs)
SYSTEM_DATABASE_URL=postgresql://admin:password@localhost:5432/mcp_system
SYSTEM_DB_BACKEND=postgres

# Target Database Configuration (database to be analyzed by the agent)
TARGET_DATABASE_URL=postgresql://user:password@localhost:5432/company_data
# Para Oracle: TARGET_DATABASE_URL=oracle+oracledb://user:password@localhost:1521/service_name
TARGET_DB_BACKEND=postgres

# LLM Configuration
LLM_MODEL_NAME=qwen3:0.6b
LLM_TEMPERATURE=0.0
OLLAMA_CONTEXT_WINDOW=4096

# API Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_TITLE=SQL Agent API
API_VERSION=0.1.0
API_PREFIX=/api/v1

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Security Configuration 
SECRET_KEY=your-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Active Directory Configuration
AD_SERVER=ldap://dc.company.com:389
AD_DOMAIN=company.com
AD_BASE_DN=DC=company,DC=com
AD_USER_DN=CN=Users,DC=company,DC=com
AD_SERVICE_USER=CN=ldap_service,CN=Users,DC=company,DC=com
AD_SERVICE_PASSWORD=service_password
AD_SEARCH_FILTER=(sAMAccountName={username})
AD_ATTRIBUTES=["sAMAccountName", "mail", "displayName", "department", "title"]

# Agent Configuration
AGENT_MAX_ITERATIONS=5
